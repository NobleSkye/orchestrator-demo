# ===========================================================================
# Minecraft Orchestration System - Environment Configuration
# ===========================================================================
# Copy this file to .env and update the values for your environment.
# This file is loaded by the systemd services via EnvironmentFile=

# ---------------------------------------------------------------------------
# Shared Authentication
# ---------------------------------------------------------------------------
# Shared secret for inter-service authentication (orchestrator <-> node agents).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Orchestrator Settings (only needed on the Velocity proxy server)
# ---------------------------------------------------------------------------
# Path to the orchestrator configuration file (node registry)
ORCHESTRATOR_CONFIG=/opt/minecraft/orchestrator.config.json

# Path to the Velocity AutoServer plugin config
AUTOSERVER_CONFIG=/opt/minecraft/velocity/autoserver/config.toml

# Path to the SQLite database for server instance tracking
ORCHESTRATOR_DB=/opt/minecraft/orchestrator.db

# Orchestrator listen address and port
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080

# ---------------------------------------------------------------------------
# Node Agent Settings (only needed on minigame nodes)
# ---------------------------------------------------------------------------
# URL of the orchestrator for callbacks and health reporting
ORCHESTRATOR_URL=http://10.0.0.1:8080

# Maximum number of Minecraft server containers on this node
MAX_SERVERS=10

# Port range for dynamic allocation (inclusive)
BASE_PORT=25566
MAX_PORT=25600

# Data directories
DATA_DIR=/opt/minecraft/instances
TEMPLATE_DIR=/opt/minecraft/templates

# Container runtime: "podman" or "docker"
CONTAINER_RUNTIME=podman

# Container image for Minecraft servers
CONTAINER_IMAGE=itzg/minecraft-server

# Node Agent listen address and port
NODE_HOST=0.0.0.0
NODE_PORT=5000

# ---------------------------------------------------------------------------
# Plugin Update Manager Settings
# ---------------------------------------------------------------------------
# Path to the plugin version registry
PLUGIN_REGISTRY=/opt/minecraft/registry.json
